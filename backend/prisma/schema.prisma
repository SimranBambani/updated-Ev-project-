// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id    Int              @id @default(autoincrement())
  name       String           @db.VarChar(100)
  email      String           @unique @db.VarChar(100)
  password   String           @db.VarChar(255)
  phone      String?          @db.VarChar(20)
  role       String           @db.VarChar(20) // Admin, Customer, Station Manager
  is_active  Boolean          @default(true)
  created_at DateTime         @default(now()) @db.Timestamp(6)
  customer   Customer[]
  manager    StationManager[]

  @@map("users")
}

model Customer {
  customer_id          Int              @id @default(autoincrement())
  user_id              Int
  user                 User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  name                 String           @db.VarChar(100)
  address              String           @db.Text
  preferred_station_id Int?
  preferred_station    ChargingStation? @relation("PreferredStation", fields: [preferred_station_id], references: [station_id], onDelete: SetNull)
  vehicles             Vehicle[]
  bookings             Booking[]
  notifications        Notification[]

  @@map("customers")
}

model StationManager {
  manager_id  Int             @id @default(autoincrement())
  user_id     Int
  user        User            @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  station_id  Int
  station     ChargingStation @relation(fields: [station_id], references: [station_id], onDelete: Cascade)
  shift       String          @db.VarChar(20) // Morning, Afternoon, Night
  allocations SlotAllocation[]

  @@map("station_managers")
}

model ChargingStation {
  station_id      Int                @id @default(autoincrement())
  station_name    String             @db.VarChar(100)
  address         String             @db.Text
  city            String             @db.VarChar(100)
  latitude        Decimal            @db.Decimal(10, 8)
  longitude       Decimal            @db.Decimal(11, 8)
  total_slots     Int                @default(0)
  available_slots Int                @default(0)
  status          String             @default("Active") @db.VarChar(20) // Active, Inactive
  preferred_by    Customer[]         @relation("PreferredStation")
  managers        StationManager[]
  slots           ChargingSlot[]
  bookings        Booking[]
  batteries       BatteryInventory[]
  reports         Report[]

  @@map("charging_stations")
}

model Vehicle {
  vehicle_id       Int       @id @default(autoincrement())
  customer_id      Int
  customer         Customer  @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  vehicle_number   String    @unique @db.VarChar(50)
  vehicle_model    String    @db.VarChar(100)
  battery_model    String    @db.VarChar(100)
  battery_capacity Float     @db.DoublePrecision
  current_charge   Float     @default(0.0) @db.DoublePrecision
  vehicle_type     String    @db.VarChar(50) // Car, Bike, Bus
  is_active        Boolean   @default(true)
  bookings         Booking[]

  @@map("vehicles")
}

model ChargingSlot {
  slot_id        Int               @id @default(autoincrement())
  station_id     Int
  station        ChargingStation   @relation(fields: [station_id], references: [station_id], onDelete: Cascade)
  slot_number    Int
  charging_speed String            @db.VarChar(20) // Fast, Normal
  slot_status    String            @default("Available") @db.VarChar(20) // Available, Occupied, Maintenance
  is_enabled     Boolean           @default(true) @db.Boolean
  allocations    SlotAllocation[]
  sessions       ChargingSession[]

  @@unique([station_id, slot_number])
  @@map("charging_slots")
}

model Booking {
  booking_id              Int              @id @default(autoincrement())
  customer_id             Int
  customer                Customer         @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  vehicle_id              Int
  vehicle                 Vehicle          @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade)
  station_id              Int
  station                 ChargingStation  @relation(fields: [station_id], references: [station_id], onDelete: Cascade)
  booking_time            DateTime         @default(now()) @db.Timestamp(6)
  estimated_waiting_time  Int              @default(0)
  estimated_charging_time Int              @default(0)
  booking_status          String           @default("Waiting") @db.VarChar(20) // Waiting, Confirmed, Cancelled
  allocations             SlotAllocation[]
  sessions                ChargingSession[]
  notifications           Notification[]

  @@map("bookings")
}

model SlotAllocation {
  allocation_id     Int            @id @default(autoincrement())
  booking_id        Int
  booking           Booking        @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  slot_id           Int
  slot              ChargingSlot   @relation(fields: [slot_id], references: [slot_id], onDelete: Cascade)
  allocated_by      Int
  manager           StationManager @relation(fields: [allocated_by], references: [manager_id], onDelete: Cascade)
  allocation_time   DateTime       @default(now()) @db.Timestamp(6)
  allocation_status String         @default("Allocated") @db.VarChar(20) // Allocated, Released

  @@map("slot_allocations")
}

model ChargingSession {
  session_id      Int          @id @default(autoincrement())
  booking_id      Int?
  booking         Booking?     @relation(fields: [booking_id], references: [booking_id], onDelete: SetNull)
  slot_id         Int
  slot            ChargingSlot @relation(fields: [slot_id], references: [slot_id], onDelete: Cascade)
  start_time      DateTime     @db.Timestamp(6)
  end_time        DateTime?    @db.Timestamp(6)
  initial_battery Float        @db.DoublePrecision
  final_battery   Float?       @db.DoublePrecision
  energy_consumed Float        @default(0.0) @db.DoublePrecision
  duration        Int?
  session_status  String       @default("Charging") @db.VarChar(20) // Charging, Completed

  @@map("charging_sessions")
}

model BatteryInventory {
  battery_id    Int             @id @default(autoincrement())
  station_id    Int
  station       ChargingStation @relation(fields: [station_id], references: [station_id], onDelete: Cascade)
  battery_model String          @db.VarChar(100)
  capacity      Float           @db.DoublePrecision
  health        Float           @default(100.0) @db.DoublePrecision
  status        String          @default("Available") @db.VarChar(20) // Available, In Use, Charging, Maintenance
  is_enabled    Boolean         @default(true) @db.Boolean

  @@map("battery_inventory")
}

model Notification {
  notification_id   Int      @id @default(autoincrement())
  customer_id       Int
  customer          Customer @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade)
  booking_id        Int?
  booking           Booking? @relation(fields: [booking_id], references: [booking_id], onDelete: SetNull)
  title             String   @db.VarChar(100)
  message           String   @db.Text
  notification_type String   @db.VarChar(50) // Slot Allocated, Charging Complete, Reminder
  status            String   @default("Unread") @db.VarChar(20) // Read, Unread
  created_at        DateTime @default(now()) @db.Timestamp(6)

  @@map("notifications")
}

model Report {
  report_id               Int             @id @default(autoincrement())
  station_id              Int
  station                 ChargingStation @relation(fields: [station_id], references: [station_id], onDelete: Cascade)
  report_type             String          @db.VarChar(20) // Daily, Weekly, Monthly
  total_vehicles          Int             @default(0)
  total_charging_sessions Int             @default(0)
  average_waiting_time    Float           @db.DoublePrecision
  average_charging_time   Float           @db.DoublePrecision
  station_efficiency      Float           @db.DoublePrecision
  generated_on            DateTime        @default(now()) @db.Timestamp(6)

  @@map("reports")
}
